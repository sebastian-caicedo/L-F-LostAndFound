---
/*
  Pantalla de inicio de sesión del encargado (RF01).

  - Las etiquetas "Usuario" y "Contraseña" van arriba de cada campo.
  - El botón para ver la contraseña está al lado de su campo.
  - Los errores se muestran en rojo dentro de la misma pantalla, nunca en
    una ventana emergente.
*/
import Base from '../layouts/Base.astro';
---

<Base titulo="Iniciar sesión">
  <!-- Si ya hay sesión abierta, se va directo al mostrador. -->
  <script is:inline slot="head">
    if (localStorage.getItem('lf_token')) {
      window.location.replace('/');
    }
  </script>

  <main class="fondo">
    <section class="caja" aria-labelledby="titulo-login">
      <div class="encabezado">
        <h1 id="titulo-login">LostAndFound</h1>
        <p>Objetos perdidos y encontrados</p>
      </div>

      <form id="formulario" novalidate>
        <div class="campo">
          <label for="usuario">Usuario</label>
          <input id="usuario" name="usuario" type="text" autocomplete="username" autofocus />
        </div>

        <div class="campo">
          <label for="contrasena">Contraseña</label>
          <div class="fila-contrasena">
            <input id="contrasena" name="contrasena" type="password" autocomplete="current-password" />
            <button
              type="button"
              id="ver-contrasena"
              class="boton-ojo"
              aria-label="Mostrar contraseña"
              aria-pressed="false"
              title="Mostrar contraseña"
            >
              <span id="icono-ojo"><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"></path><circle cx="12" cy="12" r="3"></circle></svg></span>
              <!-- El atributo hidden no funciona sobre un <svg>; por eso cada ícono va dentro de un <span>. -->
              <span id="icono-ojo-tachado" hidden><svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3l18 18"></path><path d="M10.6 6.1A9.8 9.8 0 0 1 12 6c6.5 0 10 6 10 6a17.6 17.6 0 0 1-3.2 3.9M6.6 6.6C3.8 8.4 2 12 2 12s3.5 7 10 7a9.6 9.6 0 0 0 5.4-1.6"></path><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"></path></svg></span>
            </button>
          </div>
        </div>

        <!-- Aquí aparecen los errores, en rojo, sin ventanas emergentes. -->
        <p id="error" class="mensaje-error" role="alert" hidden></p>

        <button type="submit" id="entrar" class="boton boton-principal boton-entrar">Iniciar sesión</button>
      </form>
    </section>
  </main>
</Base>

<script>
  import { iniciarSesion } from '../lib/api.js';

  const formulario = document.getElementById('formulario');
  const usuario = document.getElementById('usuario');
  const contrasena = document.getElementById('contrasena');
  const error = document.getElementById('error');
  const entrar = document.getElementById('entrar');
  const verContrasena = document.getElementById('ver-contrasena');
  const iconoOjo = document.getElementById('icono-ojo');
  const iconoTachado = document.getElementById('icono-ojo-tachado');

  function mostrarError(texto) {
    error.textContent = texto;
    error.hidden = false;
  }

  function ocultarError() {
    error.hidden = true;
    error.textContent = '';
  }

  // Si se llegó aquí porque la sesión venció, se avisa en la misma pantalla.
  const motivo = new URLSearchParams(window.location.search).get('motivo');
  if (motivo === 'vencida') {
    mostrarError('Tu sesión venció. Inicia sesión de nuevo.');
  }

  // Botón del ojo: alterna entre ver y ocultar la contraseña.
  verContrasena.addEventListener('click', () => {
    const mostrar = contrasena.type === 'password';
    contrasena.type = mostrar ? 'text' : 'password';
    iconoOjo.hidden = mostrar;
    iconoTachado.hidden = !mostrar;
    const texto = mostrar ? 'Ocultar contraseña' : 'Mostrar contraseña';
    verContrasena.setAttribute('aria-label', texto);
    verContrasena.setAttribute('aria-pressed', String(mostrar));
    verContrasena.title = texto;
    contrasena.focus();
  });

  // El error desaparece en cuanto el encargado vuelve a escribir.
  usuario.addEventListener('input', ocultarError);
  contrasena.addEventListener('input', ocultarError);

  formulario.addEventListener('submit', async (evento) => {
    evento.preventDefault();
    ocultarError();

    if (!usuario.value.trim() || !contrasena.value) {
      mostrarError('Escribe tu usuario y tu contraseña.');
      return;
    }

    entrar.disabled = true;
    entrar.textContent = 'Ingresando…';
    try {
      const correcto = await iniciarSesion(usuario.value.trim(), contrasena.value);
      if (correcto) {
        window.location.href = '/';
        return;
      }
      mostrarError('Usuario o contraseña incorrecta, intente nuevamente.');
      contrasena.value = '';
      contrasena.focus();
    } catch (e) {
      mostrarError(e.message);
    } finally {
      entrar.disabled = false;
      entrar.textContent = 'Iniciar sesión';
    }
  });
</script>

<style>
  .fondo {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: var(--azul-claro);
  }

  .caja {
    width: 100%;
    max-width: 380px;
    background: var(--blanco);
    border: 1px solid var(--borde);
    border-top: 6px solid var(--azul);
    border-radius: var(--radio-tarjeta);
    padding: 28px 28px 24px;
  }

  .encabezado {
    text-align: center;
    margin-bottom: 22px;
  }

  .encabezado h1 {
    font-size: 2rem;
    margin: 0;
  }

  .encabezado p {
    margin: 0;
    color: var(--texto-suave);
  }

  .fila-contrasena {
    display: flex;
    gap: 6px;
  }

  .boton-ojo {
    flex: 0 0 auto;
    width: 42px;
    border: 1px solid var(--azul-medio);
    border-radius: var(--radio);
    background: var(--blanco);
    color: var(--azul);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .boton-ojo span {
    display: inline-flex;
  }

  .boton-ojo span[hidden] {
    display: none;
  }

  .boton-ojo:hover {
    background: var(--azul-claro);
  }

  .boton-entrar {
    width: 100%;
    margin-top: 4px;
  }


/* LOSTANDFOUND — LOGIN NEON 3D */

.fondo {
  position: relative;
  min-height: 100svh;
  overflow: hidden;
  isolation: isolate;
  padding: 32px 18px;
  background:
    radial-gradient(ellipse at 18% 18%,
      rgba(0, 215, 255, .48), transparent 42%),
    radial-gradient(ellipse at 83% 80%,
      rgba(247, 62, 193, .48), transparent 42%),
    radial-gradient(ellipse at 85% 12%,
      rgba(146, 79, 255, .36), transparent 38%),
    linear-gradient(135deg,
      #080e2d 0%, #142b68 52%, #27104d 100%);
}

.fondo::before,
.fondo::after {
  content: "";
  position: absolute;
  z-index: -1;
  width: 250px;
  aspect-ratio: 1;
  border-radius: 50%;
  pointer-events: none;
  background:
    radial-gradient(circle at 30% 25%,
      rgba(255,255,255,.95),
      rgba(125,231,255,.45) 16%,
      rgba(124,82,245,.25) 42%,
      rgba(244,65,205,.16) 65%,
      transparent 72%);
  border: 1px solid rgba(255,255,255,.32);
  box-shadow: inset -18px -22px 35px
    rgba(41,23,124,.3), 0 0 65px
    rgba(159,86,255,.28);
  filter: blur(.3px);
}

.fondo::before {
  top: -90px;
  left: -90px;
}

.fondo::after {
  bottom: -120px;
  right: -85px;
  width: 300px;
}

.caja {
  position: relative;
  z-index: 1;
  max-width: 450px;
  padding: 38px 34px;
  border: 1px solid rgba(255,255,255,.68);
  border-top: 1px solid rgba(255,255,255,.85);
  border-radius: 32px;
  background: rgba(255,255,255,.91);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  box-shadow:
    0 25px 70px rgba(3,6,37,.4),
    0 6px 0 rgba(255,255,255,.12),
    inset 0 1px 0 #fff;
}

.encabezado {
  margin-bottom: 30px;
}

.encabezado::before {
  content: "⌕";
  display: grid;
  place-items: center;
  width: 86px;
  height: 86px;
  margin: 0 auto 18px;
  font-size: 4.5rem;
  font-weight: 800;
  line-height: 1;
  color: #fff;
  border: 2px solid rgba(255,255,255,.7);
  border-radius: 26px;
  background: linear-gradient(135deg,
    #00d9f5, #7750f6 53%, #fa4bbd);
  text-shadow: 0 3px 6px rgba(6,19,77,.4);
  box-shadow:
    0 9px 0 #40318c,
    0 17px 25px rgba(91,54,209,.38),
    inset 0 4px 9px rgba(255,255,255,.5);
  transform: rotate(-5deg);
}

.encabezado h1 {
  font-size: clamp(2.3rem, 8vw, 3.35rem);
  font-weight: 900;
  line-height: 1.13;
  letter-spacing: -.07em;
  color: #694ded;
  background: linear-gradient(100deg,
    #087bd8 8%, #8655ee 48%, #e641ad 90%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  filter: drop-shadow(0 4px 2px rgba(83,61,161,.17));
}

.encabezado p {
  margin-top: 10px;
  font-size: .95rem;
  font-weight: 600;
  color: #66708e;
}

.campo label {
  margin-bottom: 6px;
  color: #283459;
  font-weight: 700;
}

.campo input {
  min-height: 50px;
  padding: 12px 15px;
  border: 1px solid #cdd5f5;
  border-radius: 14px;
  background: rgba(255,255,255,.94);
  box-shadow: inset 0 2px 4px
    rgba(42,47,99,.04);
}

.fila-contrasena {
  gap: 8px;
}

.boton-ojo {
  width: 50px;
  border-radius: 14px;
  border-color: #cdd5f5;
}

.boton-entrar {
  min-height: 54px;
  margin-top: 12px;
  border-radius: 16px;
  font-size: 1rem;
  font-weight: 800;
  background: linear-gradient(110deg,
    #00a7ee, #7652f5, #f342bb);
  border: 0;
  color: #fff;
  box-shadow:
    0 6px 0 #5141a2,
    0 15px 24px rgba(113,66,215,.3);
}

.boton-entrar:hover {
  background: linear-gradient(110deg,
    #008dcc, #6743df, #dc2ca6);
}

.mensaje-error {
  padding: 12px;
  border-radius: 12px;
  background: #fff0f3;
}

@media (max-width: 480px) {
  .caja {
    padding: 30px 22px;
    border-radius: 26px;
  }

  .encabezado::before {
    width: 74px;
    height: 74px;
    font-size: 3.8rem;
  }
}

</style>
