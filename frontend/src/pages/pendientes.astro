---
/*
  Pendientes: reclamaciones que todavía necesitan algo del encargado (RF08).

  1. Por decidir: reclamaciones PENDIENTES, de la más antigua a la más
     reciente (se atiende primero a quien lleva más tiempo esperando). Puede
     faltar la descripción de la persona o la decisión.
  2. Por entregar: reclamaciones APROBADAS cuyo objeto sigue disponible
     (falta registrar la entrega con foto).

  El botón de cada fila abre el mostrador en el paso que le toca:
  /mostrador/reclamar?reclamacion=ID

  Endpoints: GET /reclamaciones (PENDIENTE por defecto), GET /reclamaciones?estado=APROBADA
*/
import App from '../layouts/App.astro';
---

<App titulo="Pendientes" seccion="/pendientes">
  <h1>Pendientes</h1>
  <p class="ayuda">Reclamaciones que todavía necesitan tu atención. La más antigua va primero.</p>
  <p id="error" class="mensaje-error" role="alert" hidden></p>

  <section class="seccion">
    <h2>Por decidir <span class="etiqueta" id="conteo-decidir">–</span></h2>
    <div class="envoltura-tabla">
      <table class="tabla">
        <thead>
          <tr><th>N.º</th><th>Desde</th><th>Persona</th><th>Objeto</th><th>Falta</th><th></th></tr>
        </thead>
        <tbody id="por-decidir"></tbody>
      </table>
      <p id="sin-decidir" class="vacio" hidden>No hay reclamaciones por decidir.</p>
    </div>
  </section>

  <section class="seccion">
    <h2>Por entregar <span class="etiqueta" id="conteo-entregar">–</span></h2>
    <p class="ayuda">Reclamaciones aprobadas en las que aún no se registra la entrega con foto.</p>
    <div class="envoltura-tabla">
      <table class="tabla">
        <thead>
          <tr><th>N.º</th><th>Aprobada</th><th>Persona</th><th>Objeto</th><th>Motivo</th><th></th></tr>
        </thead>
        <tbody id="por-entregar"></tbody>
      </table>
      <p id="sin-entregar" class="vacio" hidden>No hay objetos aprobados esperando entrega.</p>
    </div>
  </section>
</App>

<script>
  import { api } from '../lib/api.js';
  import { enlacePersona } from '../lib/persona.js';
  import { enlaceObjeto, siguientePaso } from '../lib/objetos.js';
  import { $, escapar, fechaHora, mostrarMensaje } from '../lib/ui.js';

  const conAlerta = (r) => (r.alerta?.activa ? ' <span class="etiqueta etiqueta-alerta">Con alerta</span>' : '');
  const celdaObjeto = (r) =>
    `<td>${enlaceObjeto(r.objeto)}<br><span class="texto-suave">${escapar(r.objeto.descripcion)}</span></td>`;
  const boton = (paso) => `<a class="boton boton-principal" href="${paso.enlace}">${paso.boton}</a>`;

  async function cargar() {
    try {
      const [pendientes, aprobadas] = await Promise.all([
        api('/reclamaciones'),
        api('/reclamaciones?estado=APROBADA'),
      ]);
      // Aprobadas cuyo objeto sigue disponible: falta la entrega.
      const porEntregar = aprobadas.filter((r) => siguientePaso(r));

      $('conteo-decidir').textContent = pendientes.length;
      $('sin-decidir').hidden = pendientes.length > 0;
      $('por-decidir').innerHTML = pendientes
        .map((r) => {
          const paso = siguientePaso(r);
          return `
            <tr>
              <td class="numero-col">${r.id}</td>
              <td>${fechaHora(r.fecha_creacion)}</td>
              <td>${enlacePersona(r.persona)}${conAlerta(r)}</td>
              ${celdaObjeto(r)}
              <td>${paso.texto}</td>
              <td>${boton(paso)}</td>
            </tr>`;
        })
        .join('');

      $('conteo-entregar').textContent = porEntregar.length;
      $('sin-entregar').hidden = porEntregar.length > 0;
      $('por-entregar').innerHTML = porEntregar
        .map((r) => `
          <tr>
            <td class="numero-col">${r.id}</td>
            <td>${fechaHora(r.decision.fecha_hora)}<br><span class="texto-suave">${escapar(r.decision.encargado.nombre)}</span></td>
            <td>${enlacePersona(r.persona)}${conAlerta(r)}</td>
            ${celdaObjeto(r)}
            <td>${escapar(r.decision.motivo)}</td>
            <td>${boton(siguientePaso(r))}</td>
          </tr>`)
        .join('');
    } catch (e) {
      mostrarMensaje($('error'), e.message);
    }
  }

  cargar();
</script>


<style>
/* LOSTANDFOUND — PENDIENTES 3D */

h1 {
  font-size: clamp(2rem, 4vw, 2.8rem);
  font-weight: 900;
  letter-spacing: -.04em;
  background: linear-gradient(
    100deg, #087bdb, #8053ed, #df42b2
  );
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}

.ayuda {
  color: #566586;
  line-height: 1.6;
}

.seccion {
  margin-top: 30px;
}

.seccion h2 {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 16px;
  font-size: 1.4rem;
  font-weight: 850;
  color: #25345f;
}

.seccion h2 .etiqueta {
  padding: 6px 13px;
  color: #fff;
  background: linear-gradient(
    120deg, #137fe2, #8754f5
  );
  border-radius: 999px;
  box-shadow: 0 5px 12px
    rgba(101,79,216,.2);
}

.seccion:nth-of-type(2) h2 .etiqueta {
  background: linear-gradient(
    120deg, #00a7b8, #257ce5
  );
}

.envoltura-tabla {
  overflow-x: auto;
  border: 1px solid #dfe5fa;
  border-radius: 23px;
  background: rgba(255,255,255,.94);
  box-shadow:
    0 14px 34px rgba(31,47,110,.12),
    inset 0 1px 0 #fff;
  backdrop-filter: blur(14px);
}

.tabla {
  border-collapse: separate;
  border-spacing: 0;
}

.tabla th {
  padding: 16px 14px;
  background: linear-gradient(
    110deg, #172b62, #493e96
  );
  color: #fff;
  font-weight: 750;
  border: 0;
}

.tabla td {
  padding: 16px 14px;
  border-top: 1px solid #ebeffa;
  vertical-align: middle;
}

.tabla tbody tr {
  transition: background .2s;
}

.tabla tbody tr:hover {
  background: #f5f2ff;
}

.tabla td .boton-principal {
  min-height: 38px;
  padding: 8px 14px;
  white-space: nowrap;
  border-radius: 12px;
}

.vacio {
  padding: 32px 20px;
  text-align: center;
  color: #657391;
}

@media (max-width: 600px) {
  .seccion h2 {
    font-size: 1.2rem;
  }

  .envoltura-tabla {
    border-radius: 18px;
  }

  .tabla th,
  .tabla td {
    padding: 12px 10px;
    font-size: .87rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  .tabla tbody tr {
    transition: none;
  }
}
</style>
