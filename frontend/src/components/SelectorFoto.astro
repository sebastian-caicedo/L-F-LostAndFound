---
/*
  Selector de foto con dos opciones (RF20, RF22):
  - Tomar la foto con la cámara web del computador.
  - Subir una foto desde un archivo (por ejemplo, tomada con un celular).

  La lógica está en lib/foto.js. La página lo activa con:
    const selector = crearSelectorFoto(document.getElementById('<id>'));
*/
interface Props {
  id: string;
  /** Texto de ayuda debajo de los botones. */
  ayuda?: string;
}

const { id, ayuda = 'JPG, PNG o WEBP, de máximo 5 MB.' } = Astro.props;
---

<div class="selector-foto" id={id}>
  <div class="selector-botones" data-botones>
    <button type="button" class="boton boton-principal" data-accion="camara">
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h3l2-3h6l2 3h3v11H4z"></path><circle cx="12" cy="13" r="3.5"></circle></svg>
      Tomar foto
    </button>
    <label class="boton boton-secundario">
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V4M7 9l5-5 5 5M4 20h16"></path></svg>
      Subir archivo
      <input type="file" accept="image/jpeg,image/png,image/webp" data-archivo class="solo-lector" />
    </label>
  </div>
  <p class="ayuda-foto" data-ayuda>{ayuda}</p>

  <div class="selector-camara" data-camara hidden>
    <video data-video autoplay playsinline muted></video>
    <div class="selector-acciones">
      <button type="button" class="boton boton-principal" data-accion="capturar">Capturar</button>
      <button type="button" class="boton boton-secundario" data-accion="cancelar">Cancelar</button>
    </div>
  </div>

  <div class="selector-vista" data-vista hidden>
    <img data-imagen alt="Vista previa de la foto" />
    <button type="button" class="boton boton-secundario" data-accion="quitar">Cambiar foto</button>
  </div>

  <p class="mensaje-error" data-error role="alert" hidden></p>
</div>
